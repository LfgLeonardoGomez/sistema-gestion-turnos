# Solo desarrollo local. No usar este archivo para secretos de producción.
POSTGRES_PASSWORD=cambiar-por-clave-local
APP_DB_PASSWORD=cambiar-por-otra-clave-local
REMINDER_DB_PASSWORD=cambiar-por-tercera-clave-local
APP_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
API_PORT=8000
COOKIE_SECURE=false
# Para crear el primer negocio: completar solo durante el bootstrap y luego borrar.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Seed demo idempotente (ejecutar explícitamente con `docker compose run --rm migrate python -m turnos.seed`).
SEED_BUSINESS_NAME=
SEED_PROFESSIONAL_PASSWORD=
# Activar el servicio opcional con: docker compose --profile reminders up
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
REMINDER_POLL_SECONDS=60
